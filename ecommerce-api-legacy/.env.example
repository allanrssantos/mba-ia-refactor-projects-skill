# Copie para .env e exporte no ambiente do processo (nenhuma biblioteca carrega este arquivo automaticamente).

PORT=3000                 # porta HTTP (default original)
HOST=                     # vazio = escuta em todas as interfaces (comportamento original); ex.: 127.0.0.1
DB_PATH=:memory:          # caminho do SQLite; ":memory:" recria schema e seed a cada boot
PAYMENT_GATEWAY_KEY=      # chave do gateway de pagamento (nunca versionar o valor real)
ADMIN_TOKEN=              # vazio = rotas /api/admin/* respondem 403; enviar no header X-Admin-Token
LOG_LEVEL=info            # debug | info | warn | error
