# Copie para .env (carregado via python-dotenv). Todos os valores são opcionais.

# Chave de sessão do Flask. Vazio = gerada a cada boot (sessões não persistem entre reinícios).
SECRET_KEY=

# Modo debug do Flask (nunca true em produção).
DEBUG=false

# Interface e porta HTTP. Use HOST=0.0.0.0 para expor na rede.
HOST=127.0.0.1
PORT=5000

# URI SQLAlchemy do banco. URIs SQLite relativas ficam em instance/.
DATABASE_URI=sqlite:///tasks.db

# Origens permitidas no CORS: "*" ou lista separada por vírgula.
CORS_ORIGINS=*

# Nível de log (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
