# Variáveis de ambiente da API da Loja (valores de desenvolvimento; nenhum segredo real aqui).
# Sem biblioteca de .env declarada: exporte as variáveis no ambiente do processo antes de `python app.py`.

PORT=5000              # porta HTTP (default igual ao original)
HOST=127.0.0.1         # use 0.0.0.0 apenas quando precisar expor na rede
DEBUG=false            # nunca true em produção (debugger do Werkzeug permite execução remota de código)
DB_PATH=loja.db        # caminho do arquivo SQLite (default igual ao original)
SECRET_KEY=            # vazio = gerado a cada boot (sessões não persistem entre reinícios)
CORS_ORIGINS=*         # lista separada por vírgula de origens permitidas; * mantém o comportamento original
ADMIN_TOKEN=           # vazio = /admin/reset-db e /admin/query respondem 403; enviar no header X-Admin-Token
LOG_LEVEL=INFO         # nível do logging da stdlib
